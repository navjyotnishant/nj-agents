#!/bin/sh
# nj-agents review gate — the LLM review, on the branches that matter.
#
# WHY THIS IS NOT IN `pre-push`. That hook runs check.sh + tests/assert.sh on every
# push: LLM-free, ~1s, cheap enough to never think about. This one spends ~5 agents
# per run, so firing it on every push is the thing three files in this repo already
# refuse to do. It fires only when the push TARGETS a protected branch — main, PRD,
# master, release/* — so the inner loop stays free and the branch that reaches
# production does not.
#
# WHY NOT ON MERGE. `pre-merge-commit` looks like the right hook and is not: git
# does not run it for a FAST-FORWARD merge, and measured against one real project's
# history, 6 of 8 merges to main were fast-forwards. A gate that silently passes on
# the majority case is worse than no gate, because it looks installed.
#
# ENV:
#   NJ_REVIEW_SKIP=1   bypass, loudly. For a hotfix, or when you have just run it.
#   NJ_REVIEW_AUTO=1   no confirmation prompt — for CI and unattended workflows.
#   NJ_REVIEW_REFS     override the protected list (space-separated short names).
#
# Bypass is also `git push --no-verify`, as with every git hook. Both are visible
# choices; neither is hidden.
#
# NOT COMMITTED — .git/ is not tracked, so this is per-clone and per-machine.
# Reinstall after a fresh clone: ./install.sh --git-hooks --project DIR

PROTECTED="${NJ_REVIEW_REFS:-main master PRD}"

# Read the refs git offers on stdin and decide whether any of them is protected.
# Format per githooks(5): <local ref> <local sha> <remote ref> <remote sha>.
# Matched on the REMOTE ref — pushing a local branch to main is still a push to
# main — and matched exactly, so `main-test` or `release-notes` do not trigger it.
targets_protected=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -n "$remote_ref" ] || continue
  short="${remote_ref#refs/heads/}"
  for p in $PROTECTED; do
    if [ "$short" = "$p" ]; then targets_protected=1; fi
  done
  case "$short" in release/*) targets_protected=1 ;; esac
done

[ "$targets_protected" = "1" ] || exit 0

if [ "$NJ_REVIEW_SKIP" = "1" ]; then
  echo "" >&2
  echo "pre-push-review: SKIPPED via NJ_REVIEW_SKIP=1 — pushing to a protected branch" >&2
  echo "                 without the review. Run /pre-push-review by hand if you have not." >&2
  exit 0
fi

if ! command -v nj-agents-review >/dev/null 2>&1; then
  # Degrade, don't fail: a missing runner is a setup gap, not a review finding, and
  # blocking every push to main over it would just get the hook deleted. Say so
  # every time — a gate that goes quiet is indistinguishable from one that is gone.
  echo "" >&2
  echo "pre-push-review: nj-agents-review is not on PATH — the review did NOT run." >&2
  echo "                 Add nj-agents/bin to PATH, or run /pre-push-review by hand." >&2
  exit 0
fi

echo "" >&2
echo "pre-push-review: pushing to a protected branch — running the review." >&2
echo "                 This spends ~5 agents. NJ_REVIEW_SKIP=1 to bypass." >&2

if [ "$NJ_REVIEW_AUTO" = "1" ] || [ ! -t 1 ]; then
  # Unattended: either explicitly opted in, or there is no terminal to ask on
  # (a workflow, a CI runner, an editor's git integration). Never hang waiting for
  # an answer nobody can give.
  :
else
  printf "                 Proceed? [Y/n] " >&2
  # stdin is the ref list, already consumed — read the answer from the terminal.
  read -r answer < /dev/tty 2>/dev/null || answer=""
  case "$answer" in
    [Nn]*)
      echo "pre-push-review: declined — push stopped. NJ_REVIEW_SKIP=1 to push anyway." >&2
      exit 1
      ;;
  esac
fi

# CI mode: the runner maps the verdict onto exit codes (0 PASS/WARN, 1 BLOCK,
# 2 harness error). `claude -p` alone always exits 0, which is why this calls the
# wrapper rather than the CLI.
NJ_AGENTS_CI=1 nj-agents-review
rc=$?

if [ "$rc" = "1" ]; then
  echo "" >&2
  echo "pre-push-review: BLOCK — push stopped." >&2
  echo "                 Fix the findings, or: NJ_REVIEW_SKIP=1 git push" >&2
  exit 1
fi

if [ "$rc" != "0" ]; then
  # A harness error is not a verdict. Blocking on it would make an unrelated
  # breakage look like a code finding, so it warns and lets the push through.
  echo "" >&2
  echo "pre-push-review: the review could not run (exit $rc) — push allowed." >&2
  echo "                 That is a tooling problem, not a finding. Worth looking at." >&2
fi

exit 0
