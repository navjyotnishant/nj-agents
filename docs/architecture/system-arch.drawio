        <mxCell id="title" value="nj-agents — suite architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="You invoke a skill; it orchestrates agents. Skills follow one of two shared convention docs. install.sh symlinks everything into ~/.claude/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="820" height="20" as="geometry"/></mxCell>

