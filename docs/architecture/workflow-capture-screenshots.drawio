        <mxCell id="e5" value="unverified → re-redact / wider blur" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;fontSize=9;fontColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="gate" target="red"><mxGeometry relative="1" as="geometry"/></mxCell>
