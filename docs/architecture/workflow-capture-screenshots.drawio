  <diagram name="capture-screenshots" id="njwf3">
    <mxGraphModel dx="1100" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="/capture-screenshots — the redaction verify-gate" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="t2" value="capture → detect PII → redact → verify. The verify step is a hard gate: if it can't confirm every flagged region is obscured, nothing is written. Only the redacted image is committed; the raw stays gitignored." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1040" height="18" as="geometry"/></mxCell>

        <mxCell id="cap" value="screenshot-capturer&#10;→ raw (gitignored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="160" height="54" as="geometry"/></mxCell>
        <mxCell id="det" value="sensitive-data-reviewer&#10;marks PII/secrets + regions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="170" height="54" as="geometry"/></mxCell>
        <mxCell id="red" value="screenshot-redactor&#10;blur / mask (sharp/jimp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="160" height="54" as="geometry"/></mxCell>
        <mxCell id="gate" value="VERIFY GATE&#10;coverage unproven&#10;→ no write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="146" width="160" height="62" as="geometry"/></mxCell>
        <mxCell id="out" value="docs/images/&#10;redacted only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="150" width="140" height="54" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="cap" target="det"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="det" target="red"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="red" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
