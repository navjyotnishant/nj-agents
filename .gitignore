.DS_Store
.nj-agents-reports/

# Python bytecode cache
__pycache__/
*.pyc
node_modules/
docs/architecture/_style-mockups.html
docs/architecture/*.layout.json
HANDOFF*.md

# Playwright MCP session scratch (console/page dumps) — local tool output
.playwright-mcp/

# Behavioral test fixtures are generated by tests/fixtures/make.sh — a git repo
# inside a git repo is a submodule trap, and they must stay disposable.
tests/fixtures/*/

# MkDocs build output and venv — generated, never committed
site/
.cache/
.venv-docs/
